# The C++ standard is declared here rather than injected through PKG_CXXFLAGS:
# pinning -std=c++11 by hand stopped this package compiling against any
# RcppArmadillo release that requires C++14 or later.
CXX_STD = CXX17

SOURCES = $(wildcard SCINET_core/*.cc)
OBJECTS = SCINET.o RcppExports.o $(SOURCES:.cc=.o)

PKG_CXXFLAGS = -I"../inst/include" -I"../inst/include/stats" \
               -DARMA_64BIT_WORD $(SHLIB_OPENMP_CXXFLAGS)

PKG_LIBS = $(BLAS_LIBS) $(LAPACK_LIBS) $(SHLIB_OPENMP_CXXFLAGS) $(FLIBS)
