Package: SCINET
Type: Package
Title: Single-Cell Imputation and NETwork inference
Version: 1.0
Date: 2018-06-01
Authors@R: c(
    person("Shahin", "Mohammadi", email = "shahin.mohammadi@gmail.com",
        role = c("cre", "aut"), comment = c(ORCID = "0000-0001-8734-2326")),
